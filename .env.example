# Optional local database. Leave blank for in-memory development data.
DATABASE_URL=
# Optional: set a unique random value for persistent local sessions.
JWT_SECRET=
# Cloudflare Workers AI (preferred; free daily allocation; requires Cloudflare account ID and API token)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional model override; default is @cf/meta/llama-3.1-8b-instruct-fp8-fast
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
# Optional Gemini alternative: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional Gemini model override (default: gemini-3.8-flash)
# AI_MODEL=gemini-3.8-flash
# Or an OpenAI-compatible service:
# AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
